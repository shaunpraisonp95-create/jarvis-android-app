<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JARVIS</title>
<style>
* { box-sizing: border-box; }
body {

  margin: 0;
  min-height: 100vh;
  background: #020810;
  color: #00eaff;
  font-family: Arial, sans-serif;
  text-align: center;
  overflow: hidden;
}
h1 {
  margin-top: 55px;
  letter-spacing: 6px;
  text-shadow: 0 0 15px #00eaff;
}

.core {
  width: 210px;
  height: 210px;
  box-sizing: border-box;
  border: 3px solid #00eaff;
  border-radius: 50%;
  margin: 0;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20px #00eaff,
              inset 0 0 20px #00eaff;
  animation: pulse 2s infinite alternate;


  
}

.core-content > span {
  font-size: 32px;
  letter-spacing: 5px;
}

.core-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  position: relative;
  z-index: 2;
}

.sound-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 35px;
}

.sound-wave span {
  display: block;
  width: 3px;
  height: 8px;
  border-radius: 5px;
  background: #00eaff;
  box-shadow: 0 0 8px #00eaff;
  animation: soundWave 1s ease-in-out infinite alternate;
}

.sound-wave span:nth-child(2n) {
  animation-delay: 0.2s;
}

.sound-wave span:nth-child(3n) {
  animation-delay: 0.4s;
}

@keyframes soundWave {
  from { height: 6px; }
  to { height: 30px; }
}


.sound-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 35px;
}

.sound-wave span {
  display: block;
  width: 3px;
  height: 8px;
  border-radius: 5px;
  background: #00eaff;
  box-shadow: 0 0 8px #00eaff;
  animation: soundWave 1s ease-in-out infinite alternate;
}

.sound-wave span:nth-child(2n) {
  animation-delay: 0.2s;
}

.sound-wave span:nth-child(3n) {
  animation-delay: 0.4s;
}

@keyframes soundWave {
  from { height: 6px; }
  to { height: 30px; }
}

p { letter-spacing: 3px; }


@keyframes pulse {
  from { transform: scale(.95); }
  to { transform: scale(1.05); }
}

/* JARVIS rotating HUD rings */
.hud {
  width: 270px;
  height: 270px;
  margin: 40px auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
  
/* JARVIS multi-layer HUD rings */
.hud::before,
.hud::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hud::before {
  inset: -14px;
  border: 2px dashed #00eaff;
  box-shadow: 0 0 12px #00eaff;
  animation: jarvisZigZag 8s linear infinite;
}

.hud::after {
  inset: -28px;
  border: 2px solid #008cff;
  border-left-color: transparent;
  border-right-color: transparent;
  box-shadow: 0 0 14px #008cff;
  animation: jarvisRotateReverse 12s linear infinite;
}

/* Additional inner HUD ring */
.core::before {
  content: "";
  position: absolute;
  inset: 10px;
  border: 1px dotted #00eaff;
  border-radius: 50%;
  pointer-events: none;
  animation: jarvisRotate 6s linear infinite reverse;

}
@keyframes jarvisRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}


@keyframes jarvisRotateReverse {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

@keyframes jarvisZigZag {
  0%   { transform: translate(0, 0) rotate(0deg); }
  25%  { transform: translate(5px, -5px) rotate(90deg); }
  50%  { transform: translate(0, 0) rotate(180deg); }
  75%  { transform: translate(-5px, 5px) rotate(270deg); }
  100% { transform: translate(0, 0) rotate(360deg); }

}


/* Futuristic JARVIS background */
body {
  background-color: #01040a;
  background-image:
    radial-gradient(circle, #00eaff 2px, transparent 3px),
    radial-gradient(circle, #008cff 2px, transparent 3px),
    linear-gradient(rgba(0, 234, 255, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 234, 255, 0.025) 1px, transparent 1px);
  background-size:
    55px 55px,
    75px 75px,
    35px 35px,
    35px 35px;
  background-position:
    0 0,
    25px 20px,
    0 0,
    0 0;
  background-attachment: fixed;
}


body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse at center,
      transparent 30%,
      rgba(0, 0, 0, 0.55) 100%);
  z-index: 0;
}

.hud {
  z-index: 1;
}

/* JARVIS futuristic edge circuits */
.edge-circuit {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 10;
  overflow: hidden;
  opacity: 1;
}

.edge-circuit::before {
  content: "";
  position: absolute;
  inset: 12px;
  background:
    linear-gradient(#00eaff, #00eaff) 0 0 / 110px 2px no-repeat,
    linear-gradient(#00eaff, #00eaff) 2px 0 / 2px 85px no-repeat,
    linear-gradient(#00eaff, #00eaff) 100% 0 / 110px 2px no-repeat,
    linear-gradient(#00eaff, #00eaff) 100% 0 / 2px 85px no-repeat,
    linear-gradient(#00eaff, #00eaff) 0 100% / 110px 2px no-repeat,
    linear-gradient(#00eaff, #00eaff) 2px 100% / 2px 85px no-repeat,
    linear-gradient(#00eaff, #00eaff) 100% 100% / 110px 2px no-repeat,
    linear-gradient(#00eaff, #00eaff) 100% 100% / 2px 85px no-repeat;
  filter: drop-shadow(0 0 5px #00eaff);
}

.edge-circuit::after {
  content: "";
  position: absolute;
  inset: 25px;
  border: 1px solid rgba(0, 140, 255, 0.5);
  clip-path: polygon(
    0 0, 20% 0, 23% 4%, 77% 4%,
    80% 0, 100% 0, 100% 20%,
    96% 23%, 96% 77%, 100% 80%,
    100% 100%, 80% 100%, 77% 96%,
    23% 96%, 20% 100%, 0 100%,
    0 80%, 4% 77%, 4% 23%, 0 20%
  );
  
}

</style>
</head>
<body>
 <div class="edge-circuit"></div>
<h1>J.A.R.V.I.S.</h1>
<div class="hud">

<div class="core">
  <div class="core-content">
    <span>J.A.R.V.I.S</span>
    <div class="sound-wave">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</div>

</div>

<p>SYSTEM ONLINE</p>
<p>AWAITING COMMAND</p>

<script>
const SpeechAPI =
  window.SpeechRecognition ||
  window.webkitSpeechRecognition;

if (SpeechAPI) {
  const jarvisVoice = new SpeechAPI();
  jarvisVoice.lang = "en-IN";
  jarvisVoice.continuous = true;
  jarvisVoice.interimResults = false;

  jarvisVoice.onresult = function(event) {
    const result =
      event.results[event.results.length - 1][0]
        .transcript.toLowerCase().trim();

    if (result.includes("hey jarvis")) {
      document.querySelector("p:last-of-type").textContent =
        "JARVIS HEARD YOU";
    }
  };

  
  jarvisVoice.onerror = function(event) {
    console.log("Voice error:", event.error);
  };

  jarvisVoice.onend = function() {
    try {
      jarvisVoice.start();
    } catch (e) {
      console.log("Restart error:", e);
    }
  };

  try {
    jarvisVoice.start();
  } catch (e) {
    console.log("Could not start listening:", e);
  }

}
</script>
</body>
</html>
